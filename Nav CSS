/* =========================================
   NAVIGATION BAR (DESKTOP & BASIS)
   ========================================= */

.main-nav {
    position: relative; 
    z-index: 1000; 
    background: rgba(36, 37, 40, 0.9); 
    backdrop-filter: blur(10px); 
    padding: 10px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05); 
}

.nav-wrapper {
    position: relative; 
    display: flex;
    justify-content: space-between; 
    align-items: center;
}

/* --- LOGO --- */
.nav-logo {
    margin: 0; 
    z-index: 10; 
}

.nav-logo img { 
    height: 35px; 
    width: auto; 
    display: block; 
}

/* --- MENÜ LINKS (Desktop) --- */
.nav-links {
    display: flex;
    list-style: none; 
    gap: 40px; 
    margin: 0;
    padding: 0;
}

.nav-links li a {
    color: #c2c2c2;
    text-decoration: none;
    font-size: 0.85rem;
    font-family: 'Open Sans', sans-serif;
    font-weight: 400; 
    letter-spacing: 0; 
    border-bottom: 0.5px solid transparent;
    padding-bottom: 0px; 
    transition: all 0.3s ease;
}

.nav-links li a:hover {
    color: #ffffff; 
    border-color: #ffffff; 
}

.nav-links li a.active {
    color: #fff;
    border-color: #ffffff;
}

/* --- WARENKORB --- */
.nav-cart {
    color: #efefef;
    font-size: 1.1rem;
    z-index: 10;
}

/* --- EXAKTE ZENTRIERUNG DES MENÜS (Desktop) --- */
@media (min-width: 769px) {
    .nav-links {
        position: absolute; 
        left: 50%;          
        transform: translateX(-50%); 
        white-space: nowrap; 
    }
}


/* =========================================
   MOBILE NAVIGATION (HAMBURGER MENÜ)
   ========================================= */

/* Mobile Buttons auf dem Desktop verstecken */
.nav-toggle, .nav-close {
    display: none;
}

@media (max-width: 768px) {
    
    /* Grid Layout für die Leiste (Burger | Logo | Cart) */
    .nav-wrapper {
        display: grid;
        grid-template-columns: 50px 1fr 50px;
        align-items: center;
        justify-items: center;
        height: 60px;
    }

    /* Elemente im Grid platzieren */
    .nav-toggle { grid-column: 1; justify-self: start; }
    .nav-logo   { grid-column: 2; margin: 0; }
    .nav-cart   { grid-column: 3; justify-self: end; }

    /* Hamburger Button Styling */
    .nav-toggle {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 30px;
        height: 20px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 1001;
    }
    .nav-toggle span {
        display: block;
        width: 100%;
        height: 2px;
        background-color: #fff;
        border-radius: 2px;
    }

    /* Das Menü (Die Liste wird zur Sidebar) */
    .nav-links {
        display: flex !important; /* Flexbox erzwingen */
        flex-direction: column;
        position: fixed;
        top: 0;
        left: -100%; /* Versteckt links */
        width: 80%;
        max-width: 300px;
        height: 100vh;
        background-color: #121212;
        border-right: 1px solid rgba(255,255,255,0.1);
        z-index: 2000;
        padding: 80px 30px; /* Platz oben für Close Button */
        margin: 0 !important; 
        transition: left 0.3s ease-in-out;
        box-shadow: 10px 0 30px rgba(0,0,0,0.5);
        transform: none !important; 
        text-align: left;
    }

    /* Wenn offen (Klasse wird via JS hinzugefügt) */
    .nav-links.active {
        left: 0;
    }

    /* Links im Mobile Menü */
    .nav-links li a {
        font-size: 1.1rem;
        display: block;
        padding: 15px 0; /* Mehr Klickfläche */
        border-bottom: 1px solid rgba(255,255,255,0); /* Trennlinien (hier auf transparent gesetzt) */
    }

    /* Schließen Button (X) */
    .nav-close {
        display: block;
        position: absolute;
        top: 20px;
        right: 20px;
        background: transparent;
        border: none;
        color: #fff;
        font-size: 2rem;
        cursor: pointer;
    }
}